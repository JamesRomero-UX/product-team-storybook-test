{
  "name": "@telegraph/tag",
  "version": "0.2.3",
  "repository": "https://github.com/knocklabs/telegraph/tree/main/packages/tag",
  "author": "@knocklabs",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "default": "./dist/css/default.css"
    },
    "./default.css": "./dist/css/default.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "prettier": "@knocklabs/prettier-config",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite build --watch --emptyOutDir false",
    "build": "yarn clean && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier \"src/**/*.{js,ts,tsx}\" --write",
    "format:check": "prettier \"src/**/*.{js,ts,tsx}\" --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@telegraph/button": "^0.7.0",
    "@telegraph/compose-refs": "^0.0.8",
    "@telegraph/helpers": "^0.0.15",
    "@telegraph/icon": "^0.5.0",
    "@telegraph/layout": "^0.5.0",
    "@telegraph/tooltip": "^0.3.0",
    "@telegraph/typography": "^0.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.38.0"
  },
  "devDependencies": {
    "@knocklabs/eslint-config": "^0.0.5",
    "@knocklabs/prettier-config": "^0.0.1",
    "@knocklabs/typescript-config": "^0.0.2",
    "@telegraph/postcss-config": "^0.1.2",
    "@telegraph/vite-config": "^0.0.15",
    "@types/react": "^19.2.9",
    "eslint": "^10.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}