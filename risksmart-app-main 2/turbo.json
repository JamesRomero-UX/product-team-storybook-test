{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ],
      "env": [
        "REACT_APP_*",
        "VITE_*",
        "NODE_OPTIONS",
        "RELOAD_SW",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "db:pull": {
      "inputs": [
        "../../api-stack/hasura/migrations/**"
      ],
      "outputs": [
        "generated-db/**"
      ]
    },
    "tsc": {
      "dependsOn": [
        "^tsc"
      ],
      "outputLogs": "full"
    },
    "generate-graphql": {
      "outputLogs": "errors-only",
      "inputs": [
        "**/*.graphql",
        "../../api-stack/**",
        "codegen.ts"
      ],
      "outputs": [
        "generated/**",
        "src/generated/**"
      ]
    },
    "//#sst:types": {
      "outputs": [
        ".sst/types/**"
      ],
      "inputs": [
        "sst.config.ts",
        "stacks/**"
      ]
    },
    "lint": {
      "env": [
        "ENABLE_NO_CYCLE"
      ]
    },
    "lint:fix": {
      "env": [
        "ENABLE_NO_CYCLE"
      ]
    },
    "test:unit": {
      "outputLogs": "new-only",
      "outputs": [
        "coverage/**",
        "html/**"
      ]
    },
    "generate:api-types": {
      "inputs": [
        "src/schemas/**",
        "src/versions/**"
      ],
      "outputs": [
        "src/generated/openapi.d.ts"
      ]
    },
    "generate:api-snapshot": {
      "outputs": [
        "api-contract.snapshot.json"
      ]
    },
    "validate:api-contract": {
      "inputs": [
        "api-contract.snapshot.json",
        "../external-api/src/schemas/**"
      ]
    },
    "test:integration": {
      "outputLogs": "full",
      "env": [
        "ZAPIER_INTEGRATION_*"
      ]
    }
  },
  "globalDependencies": [
    ".env",
    "packages/eslint-config/**"
  ]
}