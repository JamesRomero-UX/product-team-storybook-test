{
  "name": "cdk-stack",
  "version": "0.1.0",
  "bin": {
    "cdk-stack": "bin/cdk-stack.js"
  },
  "private": true,
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --ignore-pattern 'lib/int/**' --ignore-pattern 'cdk.out/**'",
    "lint:fix": "eslint . --fix --ignore-pattern 'lib/int/**' --ignore-pattern 'cdk.out/**'",
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk_depends": "pnpm install",
    "dev": "node ../scripts/dev.js",
    "dev:skip-build": "node ../scripts/dev.js --skip-build",
    "dev:skip-init": "node ../scripts/dev.js --skip-init",
    "update-tenant-table": "pnpm exec tsx scripts/update-tenant-table.ts",
    "update-tenant-table-test": "DYNAMODB_TABLE_NAME=tech-admin-risksmartApp-GlobalTenantConfig VERSION=test1 ENV=tech-admin AWS_REGION=eu-west-2 pnpm update-tenant-table",
    "cdk_build": "pnpm run build",
    "cdk_deploy_dr": "NODE_ENV=dr pnpm exec cdk deploy '*' --outputs-file cdk.outputs.json",
    "cdk_deploy": "pnpm cdk deploy --all"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "dotenv": "catalog:",
    "esbuild": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@aws-solutions-constructs/aws-wafwebacl-alb": "catalog:",
    "@aws-solutions-constructs/aws-wafwebacl-cloudfront": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "axios": "catalog:",
    "console": "catalog:",
    "csv-parse": "catalog:",
    "eslint": "catalog:",
    "source-map-support": "catalog:"
  }
}
