    ],
    "test_flow": [
      "1. Start with REST API health check to verify service is running",
      "2. Test Socket.IO connection with authentication",
      "3. Send join_conversation event",
      "4. Send send_message event and observe streaming responses",
      "5. Test typing indicators",
      "6. Test leaving conversation",
      "7. Test authentication failures with invalid tokens"
    ],
    "expected_events": [
      "connection_established - immediately after successful connection",
      "conversation_joined - after sending join_conversation",
      "message_chunk - multiple chunks during AI response streaming",
      "message_complete - final complete message after streaming",
      "user_typing - when other users are typing",
