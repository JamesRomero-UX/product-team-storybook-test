# Ascent API configuration only used in integration tests
ASCENT_BASE_URL=https://your-ascent-instance.ascentregtech.com/api/v0
ASCENT_API_KEY=your-ascent-api-key
ASCENT_PROFILE_ID=your-profile-id

# Required by local runner and integration tests
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Table and bucket names (must match init-local-aws.js)
DYNAMODB_TABLE_NAME=RulebookIngestion
TASK_STORAGE_BUCKET_NAME=tech-admin-rulebook-changes
CHANGES_BUCKET_NAME=tech-admin-rulebook-changes

# Data layer API (running locally via docker-compose)
DATA_LAYER_API_URL=http://localhost:3002

# Event router
EVENT_ROUTER_PORT=3010

# Ascent API key (bypasses Secrets Manager when IS_LOCAL=true)
INGESTION_API_KEY=your-ascent-api-key

# Tenant context
ORG_KEY=your-org-key
TENANT=multitenant

SENTRY_RELEASE=test-release
IS_LOCAL=true
