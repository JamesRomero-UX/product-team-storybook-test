# Environment variables for local development and testing
NODE_ENV=test
SENTRY_RELEASE=test-release

# Local development flag
IS_LOCAL=true

# Local endpoint for AWS services (SSM, Firehose)
LOCAL_AWS_ENDPOINT=http://localhost:8000

# AWS region
AWS_REGION=eu-west-2

# SSM parameter path for LangSmith configuration
AI_FEEDBACK_LANGSMITH_CONFIG_PARAM_NAME=/app/ai-feedback/langsmith

# Firehose delivery stream prefix
# Stream name pattern: {prefix}-{tenantId}-ai-feedback
DELIVERY_STREAM_PREFIX=tech-admin-risksmartApp
