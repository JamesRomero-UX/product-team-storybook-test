{
  "name": "@risksmart-app/request-state-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:unit": "vitest --run",
    "test:unit:changed": "vitest --run --changed origin/main",
    "test": "vitest",
    "tsc": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "putEvent:initiateAsyncRequest": "aws events put-events --endpoint-url http://localhost:3010 --region eu-west-2 --entries file://./src/tests/events/test-event-initiate-async-request.json",
    "putEvent:actionUpdateCreated": "aws events put-events --endpoint-url http://localhost:3010 --region eu-west-2 --entries file://./src/tests/events/test-event-action-update-created.json",
    "putEvent:permissionsUpdated": "aws events put-events --endpoint-url http://localhost:3010 --region eu-west-2 --entries file://./src/tests/events/test-event-permissions-updated.json",
    "putEvent:entityDeleted": "aws events put-events --endpoint-url http://localhost:3010 --region eu-west-2 --entries file://./src/tests/events/test-event-action-update-deleted.json"
  },
  "devDependencies": {
    "@risksmart-app/eslint-config": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/http-errors": "catalog:",
    "@types/node": "catalog:",
    "@types/uuid": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-check-file": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-import": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "catalog:",
    "@aws-lambda-powertools/metrics": "catalog:",
    "@aws-lambda-powertools/tracer": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-eventbridge": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@aws-sdk/util-dynamodb": "catalog:",
    "@middy/core": "catalog:",
    "@risksmart-app/domain": "workspace:*",
    "@risksmart-app/events": "workspace:*",
    "@risksmart-app/shared": "workspace:*",
    "@sentry/aws-serverless": "catalog:",
    "dotenv": "catalog:",
    "eslint-config-prettier": "catalog:",
    "http-errors": "catalog:",
    "prettier": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
