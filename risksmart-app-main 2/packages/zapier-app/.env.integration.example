# Zapier Integration Test Environment Variables
# Copy to .env.integration and fill in real values from staging

# External API client credentials (from RiskSmart staging Settings > Integrations)
ZAPIER_INTEGRATION_CLIENT_KEY=your-client-key
ZAPIER_INTEGRATION_CLIENT_SECRET=your-client-secret

# External API base URL (staging environment)
ZAPIER_INTEGRATION_API_BASE_URL=https://staging-ext-api.risksmart.com

# A valid user ID in the staging tenant (used as owner for created entities)
ZAPIER_INTEGRATION_OWNER_ID=auth0|your-staging-user-id

# Zapier CLI deploy key (for Layer 2 remote invoke tests)
# Run `zapier-platform login` or set this for CI
ZAPIER_DEPLOY_KEY=your-zapier-deploy-key
