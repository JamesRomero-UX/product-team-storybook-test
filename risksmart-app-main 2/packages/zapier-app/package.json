{
  "name": "@risksmart-app/zapier-app",
  "version": "1.0.12",
  "description": "Enterprise GRC platform for governance, risk, and compliance management — development build",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "pnpm run validate:api-contract && vitest run",
    "test:unit": "pnpm run validate:api-contract && vitest run",
    "lint": "eslint src/",
    "build": "tsup",
    "tsc": "tsc --noEmit",
    "validate": "zapier-platform validate",
    "push": "pnpm run build && zapier-platform push --skip-dep-install",
    "generate:api-snapshot": "tsx scripts/generate-api-snapshot.ts",
    "validate:api-contract": "tsx scripts/validate-api-contract.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:invoke": "tsx scripts/invoke-remote-tests.ts",
    "test:invoke-remote": "tsx scripts/invoke-remote-tests.ts --remote",
    "test:invoke-push": "pnpm run build && zapier-platform push --snapshot $(whoami) --skip-dep-install"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=6.14.6"
  },
  "dependencies": {
    "@risksmart-app/external-api": "workspace:*",
    "zapier-platform-core": "18.1.1"
  },
  "devDependencies": {
    "@risksmart-app/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "nock": "^13.5.6",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zapier-platform-cli": "18.1.1"
  },
  "zapier": {
    "id": 236769
  }
}
