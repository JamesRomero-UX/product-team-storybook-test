{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["./src/*"],
      "@risksmart-app/shared/*": ["../shared/src/*"],
      "@risksmart-app/permitio/*": ["../permitio/src/*"],
      "generated/*": ["./generated/*"]
    },
    "types": ["@risksmart-app/i18n/src/@types/i18next.d.ts", "vitest/globals"]
  }
}
