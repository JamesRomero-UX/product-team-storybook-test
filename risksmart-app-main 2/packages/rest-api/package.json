{
  "name": "@risksmart-app/rest-api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:unit": "vitest --run",
    "test:unit:changed": "vitest --run --changed origin/main",
    "test:int": "sst bind \"vitest --run --config ./vitest.integration.ts\"",
    "test": "sst bind vitest",
    "tsc": "tsc --noEmit",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace --skipMillis 50 --forceMillis 50",
    "tsc:diagnostics": "tsc --noEmit --diagnostics",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "db:pull": "touch .env && DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/postgres kysely-codegen --out-file ./generated-db/db.d.ts"
  },
  "devDependencies": {
