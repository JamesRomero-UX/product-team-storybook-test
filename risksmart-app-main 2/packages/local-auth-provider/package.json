{
  "name": "@risksmart-app/local-auth-provider",
  "version": "1.2.3",
  "description": "Auth2 JWT provider for local dev use.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --require dotenv/config --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test:unit": "echo 'no tests present'",
    "test:watch": "echo 'no tests present'",
    "test:coverage": "echo 'no tests present'",
    "tsc": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "rest",
    "openapi",
    "typescript",
    "OAuth2",
    "JWT"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "oauth2-mock-server": "^8.1.0",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@risksmart-app/eslint-config": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/express": "^5.0.6",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "dotenv": "catalog:"
  },
  "files": [
    "dist/",
    "node_modules/"
  ]
}