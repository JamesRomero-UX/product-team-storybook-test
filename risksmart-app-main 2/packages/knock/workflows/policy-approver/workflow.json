{
  "categories": [
    "policy"
  ],
  "name": "policy-approver",
  "steps": [
    {
      "branches": [
        {
          "conditions": {
            "all": [
              {
                "argument": null,
                "operator": "empty",
                "variable": "recipient.email"
              }
            ]
          },
          "name": "No Email then not a real notification user",
          "steps": [],
          "terminates": true
        },
        {
          "name": "Default",
          "steps": [],
          "terminates": false
        }
      ],
      "name": "Check User",
      "ref": "branch_2",
      "type": "branch"
    },
    {
      "channel_key": "aws-ses-risksmart-dev-cloud",
      "channel_type": "email",
      "ref": "email_1",
      "template": {
        "is_mjml": false,
        "settings": {
          "attachment_key": "attachments",
          "layout_key": "default"
        },
        "subject": "RiskSmart: New policy document version for review ",
        "visual_blocks@": "email_1/visual_blocks.json"
      },
      "type": "channel"
    },
    {
      "channel_key": "knock",
      "channel_type": "in_app_feed",
      "ref": "in_app_feed_1",
      "template": {
        "action_url": "",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "type": "channel"
    },
    {
      "channel_key": "slack-poc",
      "channel_type": "chat",
      "ref": "chat_1",
      "template": {
        "json_body@": "chat_1/json_body.json"
      },
      "type": "channel"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "environment": "development",
    "key": "policy-approver",
    "active": true,
    "valid": true,
    "created_at": "2023-11-28T14:53:38.471745Z"
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
