{
  "categories": [
    "issues"
  ],
  "name": "issue-insert",
  "steps": [
    {
      "branches": [
        {
          "conditions": {
            "all": [
              {
                "argument": null,
                "operator": "empty",
                "variable": "recipient.email"
              }
            ]
          },
          "name": "No Email then not a real notification user",
          "steps": [],
          "terminates": true
        },
        {
          "name": "Default",
          "steps": [],
          "terminates": false
        }
      ],
      "name": "Check User",
      "ref": "branch_2",
      "type": "branch"
    },
    {
      "channel_key": "knock",
      "channel_type": "in_app_feed",
      "ref": "in_app_feed_1",
      "template": {
        "action_url": "{{ vars.app_url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "type": "channel"
    },
    {
      "channel_key": "slack-poc",
      "channel_type": "chat",
      "ref": "chat_1",
      "template": {
        "json_body@": "chat_1/json_body.json"
      },
      "type": "channel"
    },
    {
      "branches": [
        {
          "conditions": {
            "any": [
              {
                "argument": "true",
                "operator": "equal_to",
                "variable": "data.digest"
              },
              {
                "argument": "true",
                "operator": "equal_to",
                "variable": "tenant.digest"
              }
            ]
          },
          "name": "Run Digest",
          "steps": [
            {
              "ref": "trigger_workflow_1",
              "settings": {
                "actor": "{{ actor.id }}",
                "cancellation_key": "{{ workflow.cancellation_key }}",
                "data": "{\"sourceData\": {{ data | json }},\n\"sourceWorkflowKey\": {{ workflow.key | json }}\n,\"sourceWorkflowCategoriesName\": {{ workflow.categories[0] | json }}\n,\"sourceRecipientConnection\":{{recipient.connection | json}} ,\"sourceVerb\": \"created\"}",
                "recipients": "{{ recipient.id }}",
                "tenant": "{{ tenant.id }}",
                "workflow_key": "digest"
              },
              "type": "trigger_workflow"
            }
          ],
          "terminates": true
        },
        {
          "name": "Default",
          "steps": [
            {
              "ref": "batch_1",
              "settings": {
                "batch_execution_mode": "accumulate",
                "batch_order": "asc",
                "batch_window": {
                  "unit": "minutes",
                  "value": 1
                },
                "batch_window_type": "fixed"
              },
              "type": "batch"
            },
            {
              "channel_key": "aws-ses-risksmart-dev-cloud",
              "channel_type": "email",
              "conditions": {
                "all": [
                  {
                    "argument": "tenant.id",
                    "operator": "equal_to",
                    "variable": "data.org_id"
                  }
                ]
              },
              "ref": "email_1",
              "template": {
                "is_mjml": false,
                "settings": {
                  "attachment_key": "attachments",
                  "layout_key": "default"
                },
                "subject": "RiskSmart: A new incident has been submitted",
                "html_body@": "email_1/html_body.html"
              },
              "type": "channel"
            }
          ],
          "terminates": false
        }
      ],
      "ref": "branch_1",
      "type": "branch"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "environment": "development",
    "key": "issue-insert",
    "active": true,
    "valid": true,
    "created_at": "2023-08-02T13:29:40.561440Z"
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
