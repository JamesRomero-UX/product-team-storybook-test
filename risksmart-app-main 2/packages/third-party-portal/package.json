{
  "name": "@risksmart-app/third-party-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "coverage:unit": "vitest run --coverage",
    "generate-theme": "npx ts-node ../theme/theme.config.ts --debug",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "serve": "vite serve",
    "start": "vite --force",
    "tsc": "tsc --noEmit",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace",
    "tsc:diagnostics": "tsc --noEmit --diagnostics"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
