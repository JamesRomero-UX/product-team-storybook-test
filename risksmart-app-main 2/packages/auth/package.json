{
  "name": "@risksmart-app/auth0-stack",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "dotenv": "dotenv",
    "test:unit": "vitest --run actions",
    "test:unit:changed": "vitest --run actions --changed origin/main",
    "tsc": "tsc --noEmit",
    "tsc:build": "tsc",
    "importBase": "sh -c 'a0deploy import --input_file ./config/tenant_$1.yaml --config_file ./config/$2/config.$1.json --debug' _",
    "import": "sh -c 'a0deploy import --input_file ./config/$2/tenant_$1.yaml --config_file ./config/$2/config.$1.json --debug' _",
    "importClients": "sh -c 'a0deploy import --input_file ./config/$2/tenant_$1-clients.yaml --config_file ./config/$2/config.$1.json --debug' _",
    "export": "sh -c 'dotenv -e .env.$1 -- a0deploy export --strip --format yaml --output_folder ./temp --config_file ./config/$2/config.$1.json --debug' _",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace --skipMillis 50 --forceMillis 50",
    "tsc:diagnostics": "tsc --noEmit --diagnostics"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/introspection": "catalog:",
    "@graphql-codegen/named-operations-object": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "@types/auth0": "catalog:",
    "@types/jest-when": "catalog:",
    "auth0-deploy-cli": "catalog:",
    "dotenv-cli": "catalog:",
    "jest-when": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "dependencies": {
    "auth0": "catalog:",
    "axios": "catalog:",
    "graphql": "catalog:",
    "typescript": "catalog:"
  }
}
