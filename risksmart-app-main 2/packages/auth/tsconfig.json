{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    // "allowJs": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "target": "ES2023",
    "skipLibCheck": true,
    "paths": {
      "@risksmart-app/auth/*": ["../actions/*"]
    }
  },
  "include": ["actions", "databases", "types", "codegen.ts"]
}
