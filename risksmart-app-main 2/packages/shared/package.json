{
  "name": "@risksmart-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "vitest  --run",
    "test:unit:changed": "vitest --run --changed origin/main",
    "tsc": "tsc --noEmit",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace --skipMillis 50 --forceMillis 50",
    "tsc:diagnostics": "tsc --noEmit --diagnostics",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "catalog:",
    "@aws-sdk/client-eventbridge": "catalog:",
    "@risksmart-app/domain": "workspace:*",
    "@risksmart-app/modules": "workspace:*",
    "@risksmart-app/eslint-config": "workspace:*",
    "@risksmart-app/i18n": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "aws4": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "i18next": "catalog:",
    "lodash": "catalog:",
    "prettier": "catalog:",
    "sanitize-html": "catalog:",
    "tree-model": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws4": "catalog:"
  }
}