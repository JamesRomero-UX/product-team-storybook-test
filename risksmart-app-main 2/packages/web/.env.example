# See https://manage.auth0.com/dashboard/uk/dev-t8t3iey3b54zkh7i/applications/eZx05JQcFBZNWXBKwEk7VvCfq4kqhKTG/settings
REACT_APP_AUTH0_DOMAIN=
# See https://manage.auth0.com/dashboard/uk/dev-t8t3iey3b54zkh7i/applications/eZx05JQcFBZNWXBKwEk7VvCfq4kqhKTG/settings
REACT_APP_AUTH0_CLIENT_ID=
# The auth0 audience
REACT_APP_API_URL=http://localhost:8080
REACT_APP_SEGMENT_KEY=
# Test different taxonomys without altering an auths auth0 metadata
REACT_APP_TAXONOMY_OVERRIDE=
REACT_APP_SLACK_CLIENT_ID=
# For local dev, this will be your ApiEndpoint: , as logged out by sst dev.
REACT_APP_REST_API_URL=https://[changeme].execute-api.eu-west-2.amazonaws.com
# Used by sentry
REACT_APP_ENVIRONMENT=dev-local
# See https://dashboard.knock.app/risksmart/development/developers/api-keys
REACT_APP_KNOCK_PUBLIC_API_KEY=
# See https://dashboard.knock.app/risksmart/integrations/channels
REACT_APP_KNOCK_FEED_CHANNEL_ID=
# Don't include the v1/graphql bit!
REACT_APP_TENANT_API_URL=http://localhost:8080
# Avoid having to choose an organisation everytime the page refreshes during development
REACT_APP_AUTH_LOCAL_STORAGE=true
# Rich text editor license key
REACT_APP_TINY_API_KEY=
# Websockets
REACT_APP_WS_TENANT_API_URL=ws://localhost:8080/v1/graphql
# Enable sentry locally for testing purposes
REACT_APP_ENABLE_SENTRY=false

REACT_APP_TRPC_API_URL=http://localhost:2021

# Integration tests
TEST_ORG=Test Organization 1
TEST_USERNAME=user1@user.com
TEST_PASSWORD=
# Dont set as a PWA
#REACT_APP_NO_PWA=true
# If you want to use https locally (may improve performance by allowing many concurrent requests)
#REACT_APP_HTTPS=true

# Option to disabel product lane
REACT_APP_DISABLE_PRODUCTLANE=true

# AMPLITUDE API Key
REACT_APP_AMPLITUDE_API_KEY=

# Enable PDF export UI (gated rollout)
REACT_APP_FEATURE_pdf_export=true

# Log any validation errors in the console. Useful for debugging form issues.
REACT_APP_LOG_FORM_ERRORS=true

# External API 
REACT_APP_EXTERNAL_API_URL=http://localhost:3200