{
  "name": "@risksmart-app/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "rm -rf node_modules/.vite",
    "build": "vite build",
    "build-storybook": "REACT_APP_NO_PWA=true storybook build",
    "coverage:unit": "vitest run src --coverage",
    "generate-types": "pnpm dlx ts-node scripts/generate-translations.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "serve": "vite serve",
    "preview": "vite preview --outDir build --port 3000",
    "prestart": "turbo build --filter=@risksmart-app/atomic-ui",
    "start": "vite --debug",
    "start:clear-cache": "pnpm start -- --force",
    "storybook": "concurrently -p \"[{name}]\" -n \"atomic-ui,web\" -c \"bgMagenta.bold,black.bgCyan.bold\" \"pnpm --filter @risksmart-app/atomic-ui run dev\" \"until curl -sf http://localhost:6007/index.json > /dev/null 2>&1; do sleep 2; done && REACT_APP_NO_PWA=true storybook dev -p 6006\"",
    "storybook:solo": "REACT_APP_NO_PWA=true storybook dev -p 6006",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest --run --coverage",
    "test:unit:changed": "vitest --run --changed origin/main",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest --watch",
    "test:storybook": "vitest --run --project storybook",
    "test:storybook:watch": "vitest --project storybook",
    "tsc": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "tsc:trace": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace  --forceMillis 3000",
    "tsc:diagnostics": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --diagnostics"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
