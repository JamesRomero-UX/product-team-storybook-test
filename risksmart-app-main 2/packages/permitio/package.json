{
  "name": "@risksmart-app/permitio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest --run",
    "test": "vitest",
    "iac-init": "source .env && tofu init -backend-config='envs/backend.tfbackend' -var-file='envs/tech-admin-eu-west-1.tfvars'",
    "iac-plan": "source .env && tofu plan -var-file='envs/tech-admin-eu-west-1.tfvars'",
    "iac-apply": "source .env && tofu apply -var-file='envs/tech-admin-eu-west-1.tfvars'",
    "iac-destroy": "source .env && tofu destroy -var-file='envs/tech-admin-eu-west-1.tfvars'",
    "iac-state": "source .env && tofu state list -var-file='envs/tech-admin-eu-west-1.tfvars'",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace --skipMillis 50 --forceMillis 50",
    "tsc:diagnostics": "tsc --noEmit --diagnostics"
  },
  "dependencies": {
    "permitio": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@risksmart-app/eslint-config": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "esbuild-plugin-file-path-extensions": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}