{
  "name": "@risksmart-app/scim-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:unit": "vitest --run src",
    "test:unit:changed": "vitest --run src --changed origin/main",
    "test": "sst bind vitest",
    "tsc": "tsc --noEmit",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "peggy:scim-filter": "peggy --plugin ../../node_modules/ts-pegjs/dist/tspegjs -o src/parsers/scim-filter.ts src/parsers/scim-filter.peggy",
    "peggy:scim-patch": "peggy --plugin ../../node_modules/ts-pegjs/dist/tspegjs -o src/parsers/scim-patch.ts src/parsers/scim-patch.peggy"
  },
  "devDependencies": {
    "@apollo/client": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/introspection": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-msw": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "@types/aws-lambda": "catalog:",
    "@types/http-errors": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "msw": "catalog:",
    "peggy": "catalog:",
    "sst": "catalog:",
    "typescript": "catalog:",
    "ts-pegjs": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "auth0": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-ssm": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "cross-fetch": "catalog:",
    "dotenv": "catalog:",
    "http-errors": "catalog:",
    "is-valid-domain": "catalog:",
    "jsonwebtoken": "catalog:",
    "prettier": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
