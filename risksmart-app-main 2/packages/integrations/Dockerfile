ARG NODE_VERSION=18
ARG N8N_VERSION

FROM docker.io/n8nio/n8n:$N8N_VERSION

ARG PGPASSWORD
ARG PGHOST
ARG PGPORT
ARG PGDATABASE
ARG PGUSER

ARG RS_API_URL

ARG USERNAME
ARG PASSWORD
ARG N8N_LOG_LEVEL
ARG RS_API_DOMAIN
ARG RS_INTEGRATIONS_API_DOMAIN
ARG WEBHOOK_URL
ARG N8N_HOST
ARG N8N_PORT
ARG N8N_PROTOCOL


ENV DB_TYPE=postgresdb
ENV DB_POSTGRESDB_DATABASE=$PGDATABASE
ENV DB_POSTGRESDB_HOST=$PGHOST
ENV DB_POSTGRESDB_PORT=$PGPORT
ENV DB_POSTGRESDB_USER=$PGUSER
ENV DB_POSTGRESDB_PASSWORD=$PGPASSWORD

ENV NODE_FUNCTION_ALLOW_EXTERNAL=*
ENV N8N_CUSTOM_EXTENSIONS /data/custom

ENV N8N_LOG_LEVEL=$N8N_LOG_LEVEL

ENV N8N_BLOCK_ENV_ACCESS_IN_NODE=false
ENV RS_API_DOMAIN=$RS_API_DOMAIN
ENV RS_INTEGRATIONS_API_DOMAIN=$RS_INTEGRATIONS_API_DOMAIN
ENV WEBHOOK_URL=$WEBHOOK_URL
ENV N8N_HOST=$N8N_HOST
ENV N8N_PORT=$N8N_PORT
ENV N8N_PROTOCOL=$N8N_PROTOCOL

USER root
COPY dist /data/custom/dist

WORKDIR  /data/custom
RUN npm install -g typescript
RUN npm install /data/custom/dist

USER node

