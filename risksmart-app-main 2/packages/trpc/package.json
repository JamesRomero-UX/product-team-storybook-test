    "test:coverage": "vitest run --coverage",
    "tsc:trace": "tsc --noEmit --generateTrace tscTrace",
    "tsc:analyze": "pnpm exec analyze-trace tscTrace",
    "tsc:diagnostics": "tsc --noEmit --diagnostics"
