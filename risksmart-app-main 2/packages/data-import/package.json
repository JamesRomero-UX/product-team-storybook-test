{
  "name": "@risksmart-app/data-import",
  "version": "0.0.0",
  "scripts": {
    "test:unit": "vitest --run",
    "test:unit:changed": "vitest --run --changed origin/main",
    "import:test": "ts-node ./tools/import.ts --dir ./test-csv",
    "reset": "rm -r -f test-csv/* && cp -R ./tools/sample-csv/. test-csv",
    "deleteOrgData": "ts-node ./tools/deleteOrgData.ts",
    "import:generated": "tsx ./tools/import.ts --dir ./generated-csv",
    "generate:sample-csv": "ts-node ./tools/sampleCsv.ts --dir ./sample-csv",
    "import": "ts-node ./tools/import.ts",
    "update": "ts-node ./tools/update.ts",
    "reassignUser": "ts-node ./tools/reassignUser.ts",
    "linkRiskActions": "ts-node ./tools/linkActionsFromRisksToControls.ts",
    "generate": "tsx ./tools/generate.ts",
    "help": "ts-node ./tools/import.ts --help",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "export": "ts-node ./tools/export.ts --dir /tmp"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@faker-js/faker": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/introspection": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@jsonforms/core": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "@risksmart-app/shared": "workspace:*",
    "@types/lodash": "catalog:",
    "commander": "catalog:",
    "csv-parse": "catalog:",
    "csv-stringify": "catalog:",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "lodash": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
