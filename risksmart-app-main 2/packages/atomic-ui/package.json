{
  "name": "@risksmart-app/atomic-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm tw:watch & STORYBOOK_COMPOSED_REF=1 storybook dev -p 6007 --ci",
    "build": "pnpm tw:build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "tw:watch": "postcss ./src/index.css -o ./src/output.css --watch",
    "tw:build": "postcss ./src/index.css -o ./src/output.css",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "pnpm tw:build && storybook build",
    "test:unit:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "shadcn:add": "npx shadcn@2.3.0 add"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "chroma-js": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:",
    "zustand": "catalog:",
    "react-hook-form": "catalog:",
    "@hookform/resolvers": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@github-ui/storybook-addon-performance-panel": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/chroma-js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@untitledui/icons": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "lucide-react": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "postcss-cli": "catalog:",
    "postcss-import": "catalog:",
    "storybook": "catalog:",
    "storybook-addon-tag-badges": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config/storybook-preview": "./config/storybook-preview.ts",
    "./output.css": "./src/output.css"
  }
}
