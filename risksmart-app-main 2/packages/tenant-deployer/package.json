{
  "name": "@risksmart-app/tenant-deployer",
  "version": "0.1.0",
  "bin": {
    "cdk-stack": "bin/cdk-stack.js"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "build": "tsc --outDir dist",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:depends": "pnpm install",
    "cdk:build": "pnpm run build",
    "cdk:deploy_dr": "NODE_ENV=dr pnpm exec cdk deploy '*' --outputs-file cdk.outputs.json",
    "cdk:deploy": "pnpm cdk deploy --all",
    "cdk:destroy": "pnpm cdk destroy --all",
    "dev:watch": "source .env && node ../../scripts/dev.js --watch-cdk --force-recreate",
    "dev:deploy": "node ../../scripts/dev.js --skip-init",
    "dev": "source .env && node ../../scripts/dev.js",
    "docker:deploy": "tsx src/deployer.ts"
  },
  "devDependencies": {
    "@risksmart-app/eslint-config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "constructs": "catalog:",
    "esbuild": "catalog:",
    "@aws-sdk/client-cloudformation": "catalog:",
    "axios": "catalog:",
    "console": "catalog:",
    "@aws-cdk/toolkit-lib": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "aws-cdk-local": "catalog:",
    "dotenv": "catalog:",
    "source-map-support": "catalog:",
    "tsx": "catalog:",
    "@tsconfig/node22": "catalog:"
  }
}