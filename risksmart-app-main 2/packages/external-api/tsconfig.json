{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["vitest/globals"],
    "esModuleInterop": true
  },
  "include": ["src/**/*", "../codegen.ts"]
}
