{
  "name": "@risksmart-app/external-api",
  "version": "0.43.0",
  "description": "External Risksmart REST API for client use.",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./openapi": "./src/schemas/openapi.schema.ts",
    "./versions": "./src/versions/index.ts",
    "./api-types": "./src/types/openapi-helpers.ts"
  },
  "scripts": {
    "dev": "tsx --require dotenv/config --watch src/index.ts",
    "dev:mock-auth": "tsx --require dotenv/config --watch src/testing/mock-auth-provider/index.ts",
    "build": "tsup",
    "build:mock-auth": "tsc -p tsconfig.auth-mock.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "generate:api-types": "tsx scripts/generate-openapi-types.ts"
  },
  "keywords": [
    "api",
    "rest",
    "openapi",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-cognito-identity-provider": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@risksmart-app/domain": "workspace:*",
    "@risksmart-app/drizzle": "workspace:*",
    "@risksmart-app/modules": "workspace:*",
    "@risksmart-app/tenant-configuration": "workspace:*",
    "@risksmart-app/trpc": "workspace:*",
    "@trpc/client": "catalog:",
    "cockatiel": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "dayjs": "catalog:",
    "dd-trace": "catalog:",
    "express": "^5.2.1",
    "express-jwt": "catalog:",
    "graphql": "catalog:",
    "helmet": "catalog:",
    "http-errors": "catalog:",
    "jwks-rsa": "catalog:",
    "jwt-decode": "catalog:",
    "lodash": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "qs": "^6.15.0",
    "rate-limiter-flexible": "catalog:",
    "superjson": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/fragment-matcher": "catalog:",
    "@graphql-codegen/introspection": "catalog:",
    "@graphql-codegen/named-operations-object": "catalog:",
    "@graphql-codegen/typed-document-node": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-react-apollo": "catalog:",
    "@graphql-codegen/typescript-resolvers": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@risksmart-app/eslint-config": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "^5.0.6",
    "@types/http-errors": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "^6.14.0",
    "@types/supertest": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "esbuild-plugin-file-path-extensions": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "oauth2-mock-server": "^8.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "catalog:",
    "supertest": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist/",
    "node_modules/"
  ]
}