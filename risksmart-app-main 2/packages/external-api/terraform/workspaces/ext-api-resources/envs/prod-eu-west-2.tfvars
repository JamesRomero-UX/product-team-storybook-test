# Generic
environment                 = "prod"
region                      = "eu-west-2"

# External API
ext_api_auth_domain_prefix  = "prod-ext-api"
ext_api_prevent_destroy     = true
ext_api_enable_backup       = true
ext_api_skip_deploy         = false
ext_api_auth0_jwk_uri       = "https://prod.uk.auth0.com/.well-known/jwks.json"
ext_api_auth0_issuer        = "https://prod.uk.auth0.com"
