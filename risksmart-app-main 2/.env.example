# Set to true if you want to enable notifications in your local dev env
LOCAL_NOTIFICATIONS_ENABLED=false
# Set to true if you want to enable scheduled notifications in your local dev env
LOCAL_SCHEDULED_NOTIFICATIONS_ENABLED=false
# Option to change the host that knock requests are made to. Useful for testing.
KNOCK_HOST=http://localhost:9090
SQS_ENDPOINT=http://localhost:9091
AUTH0_THIRD_PARTY_CLIENT_ID=
SCIM_INTERNAL_API_URL=

PDP_API_KEY=key
LOCAL_REPORTING_DATABASE_CONNECTION_STRING=postgres://reporting:reporting123!@localhost:5432/postgres
LOCAL_DATABASE_CONNECTION_STRING=postgresql://postgres:postgrespassword@localhost:5432/postgres
# SSM and Secrets Manager mocks run as Docker Compose services (ssm-mock,
# secrets-manager-mock). dev.js seeds them after CDK synth.
# URL parameters are auto-seeded from CDK synth output — no config needed.
# Non-URL SSM parameters can be seeded by setting the base env var (without the
# _PARAM_NAME / _SSM_PARAM suffix). dev.js strips the suffix automatically:
#   AI_FEEDBACK_LANGSMITH_CONFIG={"apiKey":"your-key","endpoint":"https://eu.api.smith.langchain.com"}
#   ASCENT_API_CONFIG={"baseUrl":"https://...","apiKey":"...","profileId":"..."}

TENANT=MultiTenant
IS_LOCAL=true
TENANT_CONFIG_TABLE=TenantConfig
DYNAMODB_ENDPOINT=http://localhost:8000

# The domain name from REACT_APP_REST_API_URL. This can be retrieving after an SST deployment by viewing the value of RestAPI ApiEndpoint in the console
REST_API_DOMAIN=
# This value needs to match that is in AWS param store for REST_API_KEY
REST_API_KEY="bearer e8f20db9-e5c2-4e59-a814-298a2c366c0c"

# AI Chat Agent Configuration
AI_CHAT_AGENT_ECR_IMAGE=437474201705.dkr.ecr.eu-west-2.amazonaws.com/risksmart/chat-agent:latest
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=llama3.1:8b
SUPERVISOR_TEMPERATURE=0.1
RISK_AGENT_TEMPERATURE=0.3
E2E_MOCK_MODE=false
LOG_LEVEL=debug
ENVIRONMENT=local
SENTRY_ENABLED=false

# AI BEDROCK Guardrail Configuration
BEDROCK_GUARDRAIL_IDENTIFIER=wy0ycd48g66l
BEDROCK_GUARDRAIL_VERSION=1

# PDF Service
HYBISCUS_API_KEY=SEE_RP_FOR_DEV_KEY # Needs setting in secrets manager eg AWS_PROFILE=tech-admin pnpm exec sst secrets set HYBISCUS_API_KEY {key} --stage joshbarnes
HYBISCUS_API_URL=https://api.hybiscus.dev/api/v1

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-assistant

# SSO Self Serve
AUTH0_RISK_SMART_REST_API_CLIENT_ID=
REACT_APP_AUTH0_CLIENT_ID=
AUTH0_RISK_SMART_CIRCLE_CLIENT_ID=
