{
  "name": "risksmart-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check:knock-connection-param": "if grep -R -E 'recipient\\.connection' packages/knock/workflows >/dev/null; then echo 'recipient.connection pattern found'; exit 1; else echo 'Knock connection pattern check passed'; fi",
    "check:knock-org-param": "if grep -R \"deepLinkBaseUrl\" packages/knock/workflows | grep -v \"organization={{data.deepLinkOrgId}}\" >/dev/null; then echo 'Missing organization param on some deepLinkBaseUrl links'; exit 1; else echo 'Organization param check passed'; fi",
    "start-all": "concurrently -p \"[{name}]\" -n \"Hasura,Hasura Console,SST,Web\" -c \"bgMagenta.bold,bgRed.bold,bgGreen.bold,bgBlue.bold\" \"pnpm run api\" \"pnpm run hasura-console\" \"pnpm run sst:dev\" \"pnpm run start\"",
    "sst": "sst",
    "sst:dev": "sst dev",
    "sst:build": "sst build",
    "sst:deploy": "sst deploy",
    "sst:diff": "sst diff",
    "sst:remove": "sst remove",
    "sst:console": "sst console",
    "sst:types": "sst types",
    "db:pull": "pnpm --filter @risksmart-app/rest-api db:pull",
    "backend:dev": "pnpm --filter cdk-stack dev",
    "lint": "turbo lint --concurrency=100%",
    "lint:fix": "turbo lint:fix --concurrency=100%",
    "tsc": "NODE_OPTIONS=--max-old-space-size=16384 turbo generate-graphql --concurrency=1 && turbo tsc --concurrency=100%",
    "tsc:auth": "pnpm run --filter @risksmart-app/auth0-stack tsc:build",
    "start": "pnpm run --filter @risksmart-app/web start:clear-cache",
    "start:standard": "pnpm run --filter @risksmart-app/web start",
    "preview": "pnpm run --filter @risksmart-app/web preview",
    "start-admin": "pnpm run --filter @risksmart-app/customer-management start",
    "start-integrations": "pnpm run --filter n8n-nodes-risksmart start",
    "start-tpp": "pnpm run --filter=@risksmart-app/third-party-portal start",
    "build": "turbo build --filter=@risksmart-app/web",
    "build:int": "turbo build --filter=n8n-nodes-risksmart",
    "build:trpc": "cd packages/trpc && pnpm run build",
    "build:stub-pdp": "cd packages/trpc-api-tests && pnpm run build",
    "build:mock-auth-provider": "cd packages/local-auth-provider && pnpm run build",
    "build:tenant-deployer:image": "docker build --tag tenant-deployer -f packages/tenant-deployer/Dockerfile .",
    "deploy:tenant-deployer:image": "AWS_ACCOUNT_ID=046657674620 ./packages/tenant-deployer/tenant-deployer-docker-deploy-test.sh",
    "docker:compose:mock-auth-provider": "pnpm run build:mock-auth-provider && docker compose up --build mock-auth-provider -d --wait --force-recreate",
    "docker:compose:stub-pdp": "pnpm run build:stub-pdp && docker compose up --build stub-pdp -d --wait --force-recreate",
    "build:trpc-api-tests": "cd packages/trpc-api-tests && pnpm run build",
    "serve": "pnpm run --filter @risksmart-app/web serve",
    "serve:tpp": "npm run serve -w packages/third-party-portal",
    "api": "docker compose  --profile all up",
    "api:external": "docker compose --profile external-api up",
    "api:v3": "docker compose --profile v3 up",
    "api:min": "docker compose --profile min up",
    "api:with-ai": "bash setup-ai.sh && docker compose --profile ai-chat up",
    "db:lint": "pnpm run --filter=@risksmart-app/database db:lint",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "turbo test:unit --filter=!@risksmart-app/atomic-ui --concurrency=100%",
    "test:unit:watch": "pnpm run --filter=@risksmart-app/web test:unit:watch",
    "test:unit:changed": "pnpm run --filter=* test:unit:changed",
    "test:unit:ui": "pnpm run --filter=@risksmart-app/web test:unit:ui",
    "test:unit:ui:components": "pnpm run --filter=@risksmart-app/components test:unit:ui",
    "test:e2e": "pnpm run --filter @risksmart-app/e2e test:e2e",
    "test:e2e:ui": "pnpm run --filter @risksmart-app/e2e test:e2e:ui",
    "test:integration": "pnpm run --filter @risksmart-app/tenant-configuration test:integration",
    "coverage:unit": "pnpm run --filter @risksmart-app/web coverage:unit",
    "storybook": "pnpm run --filter @risksmart-app/web storybook",
    "generate-graphql": "turbo generate-graphql --concurrency=100%",
    "generate-types": "pnpm run -r generate-types",
    "hasura": "cd api-stack/hasura && hasura",
    "hasura-console": "wait-on http-get://localhost:8080/v1/version && cd api-stack/hasura && hasura console --no-browser",
    "hasura-migrate:for-type-gen": "cd api-stack/hasura && hasura migrate apply --all-databases && hasura metadata apply && hasura metadata reload",
    "hasura-migrate:ci": "cd api-stack/hasura && hasura migrate apply --all-databases && hasura metadata apply && ../../scripts/disableDefaultOrgEvents.sh && hasura seed apply --all-databases && ../../scripts/enableDefaultOrgEvents.sh && hasura metadata reload",
    "hasura-migrate": "source .env && pnpm run hasura-migrate:ci",
    "mg": "pnpm run hasura-migrate && pnpm run generate-graphql",
    "hasura-migrate-undo": "cd api-stack/hasura && hasura migrate apply --down 1 --all-databases && hasura metadata reload",
    "knock": "pnpm run --filter @risksmart-app/knock knock",
    "knock:push": "pnpm run --filter @risksmart-app/knock knock:push",
    "knock:pull": "pnpm run --filter @risksmart-app/knock knock:pull",
    "knock:configure": "pnpm run --filter @risksmart-app/knock knock:configure",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "permit:iac-init": "pnpm run --filter @risksmart-app/permitio iac-init",
    "permit:iac-plan": "pnpm run --filter @risksmart-app/permitio iac-plan",
    "permit:iac-apply": "pnpm run --filter @risksmart-app/permitio iac-apply",
    "sync-permit": "./packages/permitio/sync-permit.sh",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clearTurboCache": "find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "trpc:docker:build": "pnpm run --filter @risksmart-app/trpc docker:build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "dynamodb:restart": "docker compose down dynamodb-local && docker compose up dynamodb-local -d --wait",
    "create-service": "bash ./scripts/create-service.sh",
    "migration:tracker": "node scripts/audit-graphql-migrations.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@faker-js/faker": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@typescript/analyze-trace": "^0.10.1",
    "aws-cdk-lib": "catalog:",
    "concurrently": "catalog:",
    "constructs": "catalog:",
    "dependency-cruiser": "catalog:",
    "dotenv": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-import": "catalog:",
    "hasura-cli": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "sst": "catalog:",
    "tsc-files": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "cdk-stack"
  ],
  "dependencies": {
    "@aws-cdk/toolkit-lib": "catalog:",
    "@aws-sdk/client-rds": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
