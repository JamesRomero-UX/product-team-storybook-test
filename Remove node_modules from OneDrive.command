#!/bin/bash
# ─────────────────────────────────────────────────────────────
#  Moves node_modules out of OneDrive so the folder syncs fast.
#  Your local Storybook keeps working — team members install
#  their own node_modules via the Setup script.
# ─────────────────────────────────────────────────────────────

ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-RiskSmart/Product - Product Dream Team/product-team-storybook"
BACKUP="$HOME/node_modules_onedrive_backup"

mkdir -p "$BACKUP"

clear
echo ""
echo "╔══════════════════════════════════════════╗"
echo "║   Remove node_modules from OneDrive      ║"
echo "╚══════════════════════════════════════════╝"
echo ""

# 1. Storybook node_modules
SB_NM="$ONEDRIVE/node_modules"
if [ -d "$SB_NM" ]; then
  echo "⏳  Moving product-team-storybook/node_modules..."
  mv "$SB_NM" "$BACKUP/storybook_node_modules" && \
    echo "✅  Done." || echo "❌  Failed — is it still in use?"
else
  echo "✅  product-team-storybook/node_modules already removed."
fi

echo ""

# 2. risksmart-app node_modules
APP_NM="$ONEDRIVE/risksmart-app-main 2/node_modules"
if [ -d "$APP_NM" ]; then
  echo "⏳  Moving risksmart-app-main 2/node_modules (this one is large — hang tight)..."
  mv "$APP_NM" "$BACKUP/risksmart_node_modules" && \
    echo "✅  Done." || echo "❌  Failed — is it still in use?"
else
  echo "✅  risksmart-app-main 2/node_modules already removed."
fi

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║   ✅  Done!                              ║"
echo "║                                          ║"
echo "║   OneDrive will now sync quickly.        ║"
echo "║   Backups saved to:                      ║"
echo "║   ~/node_modules_onedrive_backup/        ║"
echo "╚══════════════════════════════════════════╝"
echo ""
read -rp "    Press Enter to close..."
